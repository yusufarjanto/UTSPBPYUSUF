<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EVENT REGISTRATION" android:textSize="22sp" />
    <EditText android:id="@+id/etSatu"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Nama Peserta" />
    <EditText android:id="@+id/etDua"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Nama Event" />
    <EditText android:id="@+id/etJumlah"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Jumlah Tiket"
        android:inputType="number" />
    <Button android:id="@+id/btnHitung"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Hitung dan Lihat Hasil" />
</LinearLayout>